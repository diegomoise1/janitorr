{
  "Application": {
    "DryRun": true,
    "LeaveBlacklistedTagsAlone": true,
    "LibraryRefreshLimitInHours": 24,
    "FileSystem": "/data",
    "Jellyseerr": {
      "Url": "http://jellyseerr:5055",
      "ApiKey": "your-jellyseerr-api-key-here",
      "SkipFriends": false
    },
    "MediaServer": {
      "Type": "jellyfin",
      "Url": "http://jellyfin:8096",
      "ApiKey": "your-jellyfin-api-key-here",
      "Username": "",
      "Password": "",
      "UserId": 1
    },
    "Radarr": {
      "Url": "http://radarr:7878",
      "ApiKey": "your-radarr-api-key-here",
      "TagsToExclude": [1, 2],
      "TagsToInclude": []
    },
    "Sonarr": {
      "Url": "http://sonarr:8989", 
      "ApiKey": "your-sonarr-api-key-here",
      "TagsToExclude": [1, 2],
      "TagsToInclude": []
    },
    "Cleanup": {
      "Schedule": "0 */4 * * *",
      "EnableMovieCleanup": true,
      "EnableSeasonCleanup": true,
      "EnableWeeklyEpisodeCleanup": false,
      "EnableTagBasedCleanup": false,
      "MovieDeletionDelayDays": 7,
      "SeasonDeletionDelayDays": 14,
      "EpisodeDeletionDelayDays": 3
    },
    "Webhooks": {
      "Enabled": true,
      "RetryAttempts": 3,
      "TimeoutSeconds": 30,
      "Endpoints": [
        {
          "Url": "https://your-webhook-endpoint.com/janitorr",
          "Events": [
            "MediaMarkedForDeletion",
            "MediaDeleted",
            "CleanupCompleted"
          ],
          "Headers": {
            "Authorization": "Bearer your-token-here"
          },
          "Secret": "your-webhook-secret-for-hmac-verification"
        }
      ]
    }
  }
}
